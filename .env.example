# Copy to .env for docker compose. All variables are optional.
ATHENA_PUBLIC_URL=https://drones.example.com
ATHENA_DOMAIN=drones.example.com
# Behind the Caddy proxy (compose profile tls): believe its X-Forwarded-For – and publish the
# app on this host only, so that clients cannot reach it around the proxy.
ATHENA_TRUST_PROXY=1
ATHENA_HTTP_PUBLISH=127.0.0.1:8080
# openssl rand -hex 32
ATHENA_SECRET_KEY=
# smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Athena-sky <no-reply@example.com>
# Sign-ups confirm their e-mail address first (default: on when SMTP_URL is set)
ATHENA_SIGNUP_CONFIRM_EMAIL=
ATHENA_DEMO=0
